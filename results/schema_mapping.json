        "safe_z123": "a_jh for strict hazard constraint"
      },
      "derived": {
        "baseline": "a_jh = 1 for every candidate"
      }
    },
    "data\\processed\\od\\OD.csv": {
      "role": "OD road-network distances and reachability",
      "columns": {
        "demand_id": "i (demand location identifier)",
