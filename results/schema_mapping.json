      }
    },
    "data\\processed\\04_Demand_Points_Night.csv": {
      "role": "Night demand",
      "columns": {
        "demand_id": "i (demand location identifier)",
        "mobility_i": "raw mobility activity intensity; normalized to w_it"
      }
    },
    "data\\processed\\01_Shelter_Candidates_Hazard_438.csv": {
      "role": "shelter candidates and hazard feasibility",
      "columns": {
        "candidate_id": "j (candidate shelter identifier)",
